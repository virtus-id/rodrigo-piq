# Variáveis de ambiente do PIQ — MODELO.
#
# Copie para `.env` e preencha com os valores reais. O `.env` NUNCA entra no
# repositório (`.gitignore`); só este modelo entra, e ele não carrega segredo
# nenhum.
#
# Nenhum valor abaixo tem padrão embutido no código: faltando qualquer um, a
# aplicação falha ao subir, nomeando a variável. É deliberado — um padrão
# silencioso vira credencial de teste rodando em produção, ou link de
# primeiro acesso apontando para `localhost` no e-mail de um cliente real.

# ---------------------------------------------------------------------------
# Banco (Supabase Postgres)
# ---------------------------------------------------------------------------
# A string de conexão completa. No Supabase: Project Settings → Database →
# Connection string → URI. Use o pooler (porta 6543) para a aplicação.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Assina o cookie de sessão. Trocar esta chave desloga todo mundo.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAVE_ASSINATURA_SESSAO=

# ---------------------------------------------------------------------------
# Motor de cálculo
# ---------------------------------------------------------------------------
# Versão dos parâmetros vigente, conforme `parameters/parametros-<versão>.json`.
# Sem ela o cálculo do plano falha — e falha só quando o primeiro cliente
# termina a coleta, não ao subir. Confira que a linha correspondente existe
# em `motor_calculo.parametros` (ver `scripts/semear_parametros.py`).
PARAMETROS_VERSION_VIGENTE=1.0.1

# ---------------------------------------------------------------------------
# Endereço público da aplicação
# ---------------------------------------------------------------------------
# Base dos links que vão nos e-mails. SEM barra no fim.
# Errar aqui manda o cliente para um link quebrado, e ele não tem outro
# caminho de entrada.
URL_BASE_APP=https://piq.seudominio.com.br

# ---------------------------------------------------------------------------
# Provisionamento (integração com a Hotmart)
# ---------------------------------------------------------------------------
# Segredo que a automação envia no cabeçalho `X-PIQ-Provisionamento` para
# criar a conta de quem comprou. Quem tiver este valor cria contas no
# sistema — trate como senha.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEGREDO_PROVISIONAMENTO=

# ---------------------------------------------------------------------------
# E-mail (AWS SES por SMTP)
# ---------------------------------------------------------------------------
# Os nomes são em pt-BR por convenção do projeto (regra 6 do CLAUDE.md).
# No console do SES eles aparecem como SES_SMTP_HOST/PORT/USER/PASS.
SMTP_SERVIDOR=email-smtp.us-east-2.amazonaws.com
SMTP_PORTA=587
# Credencial SMTP do SES.
#
# ATENÇÃO — o erro mais fácil de cometer aqui, verificado em 2026-09-22:
# a senha SMTP NÃO é a "Secret access key" do IAM. São valores diferentes, e
# usar a secret key direto falha com `535 Authentication Credentials Invalid`,
# que parece credencial errada e não é — é a credencial certa no formato
# errado.
#
# Como distinguir num relance:
#   SMTP_USUARIO : 20 caracteres, começa com `AKIA`  (igual à access key)
#   SMTP_SENHA   : 44 caracteres, começa com `B`     (derivada da secret key)
#   secret key   : 40 caracteres, NÃO começa com `B` (NÃO serve aqui)
#
# A senha SMTP sai pronta do console: SES → SMTP settings → Create SMTP
# credentials. Ela só aparece UMA vez, no download do CSV — se perder, gere
# outra. (Também dá para derivá-la da secret key pelo algoritmo SigV4 da AWS,
# mas pegar do console é mais simples e menos sujeito a erro.)
SMTP_USUARIO=
SMTP_SENHA=
# O "De:" das mensagens. Precisa estar VERIFICADO no SES, senão o envio é
# recusado com `554 Message rejected`.
SMTP_REMETENTE=noreply@seudominio.com.br
