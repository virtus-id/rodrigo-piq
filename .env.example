# Copie para .env no servidor (chmod 600). O .env nunca é versionado.

# Supabase: Connect > Session pooler (porta 5432). NÃO use a porta 6543
# (transaction mode quebra os prepared statements do psycopg 3) nem o host
# db.<ref>.supabase.co (só IPv6; os containers não têm IPv6).
# Caracteres especiais na senha precisam de URL-encode (@ vira %40).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require

# Assina o cookie de sessão. Gere com: openssl rand -hex 32
CHAVE_ASSINATURA_SESSAO=

# Versão dos parâmetros do motor que já está semeada no banco.
PARAMETROS_VERSION_VIGENTE=1.0.1
